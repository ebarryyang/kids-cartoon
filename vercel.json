{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "npm install --no-audit --no-fund",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/course-materials(.*)", "destination": "/api/course-materials" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/((?!.*\\.).*)", "destination": "/admin/index.html" },
    { "source": "/((?!api)(?!.*\\.).*)", "destination": "/client/index.html" }
  ]
}
